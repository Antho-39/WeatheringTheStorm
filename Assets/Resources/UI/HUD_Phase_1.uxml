<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" enabled="true" style="flex-grow: 1; display: none;">
        <ui:Label text="&quot;Welcome to Montparis Bay, the jewel of the coast but a tinderbox waiting for trouble. I’m Mayor Roberta &quot;Rob&quot; Montouir, and I need your help.&#10;&#10;The forecast? Hot, dry, and windy. Wildfire season is upon us. Your mission is critical&lt;/color=red&gt;&lt;/b&gt;:&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Place fire crews&lt;/b&gt;&lt;/color=yellow&gt;—They will protect homes and forests.&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Create fire lines&lt;/b&gt;&lt;/color=yellow&gt;—By controlling the fires ourselves, we&apos;ll be better prepared.&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Place safe zones&lt;/b&gt;&lt;/color=yellow&gt;—Because when the flames roar, every second counts.&#10;&#10;Every choice you make now will decide how well we handle the heat later. Let’s make Montparis Bay fire-ready!&#10;&#10;       &lt;b&gt;Remember:&lt;/b&gt; Preparation isn’t glamorous, but it’s what saves lives.&#10;       Ready to get started? You have &lt;color=purple&gt;&lt;b&gt;3 minutes&lt;/b&gt;&lt;/color=purple&gt; and &lt;color=purple&gt;&lt;b&gt;$10,000&lt;/b&gt;&lt;/color=purple&gt; to work with.&quot;" name="IntroText" selectable="true" focusable="true" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 25px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); display: flex; -unity-font-style: normal;" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 75%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Sprites/sunglasses.png?fileID=2800000&amp;guid=d11d83dbad23aba43bb75ca1e99b122b&amp;type=3#sunglasses&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Button text="NEXT" name="IntroNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="Controls" style="flex-grow: 1; display: none; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;);">
        <ui:Label text="&#x9;&#x9;&#x9;&lt;size=80&gt;&lt;color=yellow&gt;&lt;b&gt;Controls&lt;/color=yellow&gt;&lt;/b&gt;&lt;/size&gt;" name="ControlsText" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 40px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
