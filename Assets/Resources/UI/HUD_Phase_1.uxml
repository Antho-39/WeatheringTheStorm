<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: flex;">
        <ui:Label text="&quot;Welcome to Montparis Bay, the jewel of the coast—and right now, a tinderbox waiting for trouble. I’m Mayor Roberta &quot;Rob&quot; Montouir, and I need your help.&#10;The forecast? Hot, dry, and windy. Translation: wildfire season is knocking at our door. Your mission in this phase is &lt;b&gt;simple&lt;/b&gt; but &lt;b&gt;&lt;color=red&gt;critical&lt;/color=red&gt;&lt;/b&gt;:&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Assess the risks&lt;/b&gt;&lt;/color=yellow&gt;—scan our neighborhoods and spot the danger zones&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Upgrade defenses&lt;/b&gt;&lt;/color=yellow&gt;—hire fire crews, create fire lines.&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Plan a safe zone&lt;/b&gt;&lt;/color=yellow&gt;—because when the flames roar, every second counts.&#10;&#10;Think of it like a puzzle: every choice you make now will decide how well we handle the heat later. So grab your clipboard, channel your inner hero, and let’s make Montparis Bay fire-ready!&#10;&#10;       &lt;b&gt;Remember:&lt;/b&gt; preparation isn’t glamorous, but it’s what saves lives.&#10;       Ready to get started?&quot;&#10;" name="IntroText" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 45px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/Pix32.ttf?fileID=12800000&amp;guid=2aa8d7de24ddbe64cb8d6bd3d99753c1&amp;type=3#Pix32&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 75%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Sprites/sunglasses.png?fileID=2800000&amp;guid=d11d83dbad23aba43bb75ca1e99b122b&amp;type=3#sunglasses&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: normal;" />
        <ui:Button text="NEXT" name="NextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
    </ui:VisualElement>
    <ui:VisualElement name="Phase_1" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="CustomCursor" picking-mode="Ignore" style="width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/Content/Textures/UI/cursor_1.png?fileID=2800000&amp;guid=8ac7971e824798148be852a819ac453b&amp;type=3#cursor_1&quot;); position: absolute;" />
        <ui:VisualElement name="Container" style="flex-grow: 1;">
            <ui:VisualElement name="Header" class="header" style="flex-grow: 1; position: absolute;">
                <ui:Label text="Phase 1 : PREPARATION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px; left: 100%;" />
            </ui:VisualElement>
            <ui:VisualElement name="TimeIcon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Sprites/circle.png?fileID=2800000&amp;guid=22eba9e5a0a2a3a4f8ed2a13c29b36d4&amp;type=3#circle&quot;); background-size: 150% 150%; width: 150px; height: 150px; top: 5px; left: 5px; position: absolute;">
                <ui:Label text="3:00" name="TimeLabel" style="position: absolute; top: 45px; left: 50px; height: 50px; width: 50px; justify-content: flex-start; align-self: center; align-content: center; -unity-text-align: middle-center; font-size: 35px; color: rgb(255, 255, 255);" />
            </ui:VisualElement>
            <ui:VisualElement name="MoneyIcon" style="flex-grow: 1; top: 20px; left: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/money.png?fileID=2800000&amp;guid=df443dca3845297479faa41c489791b0&amp;type=3#money&quot;); width: 50%; height: 50%; min-width: 100px; min-height: 75px; max-width: 0%; max-height: 0%; position: absolute; bottom: 0%; right: 0%; align-self: center; align-content: center; align-items: flex-start; flex-direction: column;">
                <ui:Label text="10 000 $" name="MoneyLabel" style="top: 70px; left: -25px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
