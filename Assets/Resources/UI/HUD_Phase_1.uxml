        <ui:Button text="NEXT" name="ControlsNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="Phase_1" style="flex-grow: 1; display: flex; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;);">
        <ui:VisualElement name="Container" style="flex-grow: 1;">
            <ui:VisualElement name="Header" class="header" style="flex-grow: 1; position: absolute;">
                <ui:Label text="Phase 1 : PREPARATION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 40px; padding-top: 25px; left: 40%; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="TimeIcon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Images/Timer.png?fileID=2800000&amp;guid=05b8c06411403c64bb7d1d5697e509b0&amp;type=3#Timer&quot;); background-size: 150% 150%; width: 75px; height: 75px; top: 10px; left: 50px; position: absolute; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;); -unity-font-style: normal; color: rgb(255, 255, 255); font-size: 20px; background-color: rgba(0, 0, 0, 0); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); -unity-text-outline-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); text-shadow: 0 0 0 rgb(0, 0, 0); -unity-text-outline-width: 0;">
                <ui:Label text="3:00" name="TimeLabel" style="position: absolute; top: 80px; left: 0; height: 50px; width: 50px; justify-content: flex-start; align-self: center; align-content: center; -unity-text-align: middle-center; font-size: 20px; color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); -unity-font-style: bold;" />
