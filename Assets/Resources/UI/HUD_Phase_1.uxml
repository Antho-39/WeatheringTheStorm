        <ui:Label text="Move in the map" name="MoveControlLabel" style="position: absolute; top: 315px; left: 820px; width: 20%; height: 5%; color: rgb(255, 255, 255); font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
