    <ui:VisualElement name="StarratingScreens" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="OneStarrating" style="flex-grow: 1; display: none;">
            <ui:Label text="&lt;color=yellow&gt;“Ashes and Regrets”&lt;/color=yellow&gt;&#10;&#10;&#10;&lt;color=purple&gt;&lt;b&gt;Mayor:&lt;/color=purple&gt;&lt;/b&gt;  &#10;“Montparis Bay looks… crispy. &#10;&#10;We’ll rebuild, but next time, maybe don’t roast the whole town? &#10;&#10;Our community morale is in the basement—give it another shot!”&#10;&#10;&#10;&lt;color=green&gt;&lt;b&gt;Captain:&lt;/color=green&gt;&lt;/b&gt;&#10;  “Yikes! That fire danced circles around us. &#10;&#10;Social impact? Let’s just say the squirrels are filing complaints. &#10;&#10;Hop back in and show those flames who’s boss!”" name="Ashesandregrest" selectable="true" focusable="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 24px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px; left: 25px; right: 50px; width: 1850px; border-left-width: 10px; border-top-width: 10px; border-bottom-width: 10px;" />
            <ui:VisualElement name="Mayor1star" style="flex-grow: 1; position: absolute; height: 422px; width: 442px; top: 62%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Images/Mayor.png?fileID=2800000&amp;guid=0d0639b5dc48008448f48cfb8977c7b2&amp;type=3#Mayor&quot;);" />
            <ui:VisualElement name="Captain1star" style="flex-grow: 1; position: absolute; height: 422px; width: 442px; top: 670px; left: 1398px; background-image: url(&quot;project://database/Assets/Content/Images/Captain.png?fileID=2800000&amp;guid=5a9cfbaca0872d542ab5da85a91bb713&amp;type=3#Captain&quot;);" />
            <ui:VisualElement name="FullStar11" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 20%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20full%20.png?fileID=2800000&amp;guid=ac9b8b1ad1c2e274d8b8d91376b17085&amp;type=3#Star full &quot;);" />
            <ui:VisualElement name="EmptyStar14" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 50%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="EmptyStar15" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 60%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="EmptyStar12" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 30%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="EmptyStar13" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 40%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="TwoStarrating" style="flex-grow: 1; display: none;">
            <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Singed but Standing”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10;  “We saved some homes, but morale’s shaky. &#10;&#10;Folks are calling it ‘The Great Toast.’ &#10;&#10;Replay and prove you can turn sparks into hope!”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10; “Not bad, but the fire still scored more points than us. &#10;&#10;The community’s hanging on—barely. &#10;&#10;Ready to crank up the hero mode?”" name="Singedbutstanding" parse-escape-sequences="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 24px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px; border-top-width: 10px; border-left-width: 10px; width: 1850px; left: 25px;" />
            <ui:VisualElement name="Mayor2star" style="flex-grow: 1; position: absolute; height: 414px; width: 428px; top: 62%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Images/Mayor.png?fileID=2800000&amp;guid=0d0639b5dc48008448f48cfb8977c7b2&amp;type=3#Mayor&quot;);" />
            <ui:VisualElement name="FullStar21" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 20%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20full%20.png?fileID=2800000&amp;guid=ac9b8b1ad1c2e274d8b8d91376b17085&amp;type=3#Star full &quot;);" />
            <ui:VisualElement name="FullStar22" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 30%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20full%20.png?fileID=2800000&amp;guid=ac9b8b1ad1c2e274d8b8d91376b17085&amp;type=3#Star full &quot;);" />
            <ui:VisualElement name="EmptyStar24" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 50%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="EmptyStar25" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 60%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="EmptyStar23" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 0%; left: 40%; background-image: url(&quot;project://database/Assets/Content/Images/Star%20frame.png?fileID=2800000&amp;guid=b9e6d0fe47dc3754ba77f7727ea03dc1&amp;type=3#Star frame&quot;);" />
            <ui:VisualElement name="Captain2star" style="flex-grow: 1; position: absolute; height: 414px; width: 428px; top: 667px; left: 1352px; background-image: url(&quot;project://database/Assets/Content/Images/Captain.png?fileID=2800000&amp;guid=5a9cfbaca0872d542ab5da85a91bb713&amp;type=3#Captain&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="ThreeStarrating" style="flex-grow: 1; display: none; left: 25px; width: 1850px;">
            <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Holding the Line”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10; “Solid work! Montparis Bay survived, but scars remain.&#10;&#10;People are grateful, yet dreaming of a stronger comeback. &#10;&#10;Want to aim higher?”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“Nice! You fought hard, saved lives, and gave the fire &#10;&#10;a run for its money. Social impact? Decent. &#10;&#10;But hey, why settle for decent?”" name="Holdingtheline" parse-escape-sequences="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 24px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px; border-top-width: 10px; border-left-width: 10px;" />
