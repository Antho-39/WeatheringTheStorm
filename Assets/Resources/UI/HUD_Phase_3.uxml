    <ui:VisualElement name="2Starrating" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Singed but Standing”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10;  “We saved some homes, but morale’s shaky. &#10;&#10;Folks are calling it ‘The Great Toast.’ &#10;&#10;Replay and prove you can turn sparks into hope!”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10; “Not bad, but the fire still scored more points than us. &#10;&#10;The community’s hanging on—barely. &#10;&#10;Ready to crank up the hero mode?”" name="Singedbutstanding" parse-escape-sequences="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 25px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px;" />
