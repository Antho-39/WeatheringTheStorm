            <ui:VisualElement name="EndPhase2" style="flex-grow: 1; width: 425px; height: 380px; top: 100px; left: -1px; align-content: stretch; align-self: flex-start; right: 1186px; bottom: 612px; align-items: stretch; justify-content: flex-start; position: absolute; text-shadow: 0 0 0 rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.98); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 15px;">
