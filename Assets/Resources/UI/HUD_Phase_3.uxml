<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: flex;">
        <ui:Label text="&#x9;&lt;b&gt;Welcome back !&lt;/b&gt;&#10;&#10;Montparis Bay owes you more than words can say. The fire took its toll—homes lost, habitats scarred—but because of your courage, we still have a future to fight for.&#10;Now comes the hardest part: rebuilding.&#10;&lt;b&gt;Let&apos;s work on it !&lt;/b&gt;&#10;&#10;&#x9;&lt;color=yellow&gt;- Repair homes and infrastructure so families can return.&#10;&#x9;- Restore our environment—plant new life, heal the land.&#10;&#x9;- Lift community morale—because hope is as vital as water.&lt;/color=yellow&gt;&#10;&#10;The good news ? Help is on the way. Volunteers, supplies, and even a disaster relief fund of $50000 are rolling in. We’re not alone in this. Together, we’ll make Montparis Bay stronger, safer, and more resilient than ever.&#10;&#10;You’ve already proven you can lead in a crisis. Now, let’s lead in recovery. Ready to turn ashes into opportunity?&quot;" name="IntroText" selectable="true" focusable="true" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 35px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 75%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Sprites/sunglasses.png?fileID=2800000&amp;guid=d11d83dbad23aba43bb75ca1e99b122b&amp;type=3#sunglasses&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: normal;" />
        <ui:Button text="NEXT" name="IntroNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
    </ui:VisualElement>
    <ui:VisualElement name="Controls" style="flex-grow: 1; display: none;">
        <ui:Label text="&#x9;&#x9;&#x9;&lt;size=80&gt;&lt;color=yellow&gt;&lt;b&gt;Controls&lt;/color=yellow&gt;&lt;/b&gt;&lt;/size&gt;" name="ControlsText" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 45px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/Pix32.ttf?fileID=12800000&amp;guid=2aa8d7de24ddbe64cb8d6bd3d99753c1&amp;type=3#Pix32&quot;);" />
        <ui:VisualElement name="Interact" style="flex-grow: 1; position: absolute; left: 438px; top: 455px; width: 150px; height: 150px; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/mouse_left.png?fileID=2800000&amp;guid=0f46d347aa084084fb0c8403d4538ea1&amp;type=3#mouse_left&quot;);" />
        <ui:Label text="Validate/Interact" name="ClicklLabel" style="position: absolute; top: 500px; left: 820px; width: 20%; height: 5%; color: rgb(255, 255, 255); font-size: 45px;" />
        <ui:Button text="NEXT" name="ControlsNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
    </ui:VisualElement>
    <ui:VisualElement name="Phase_3" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
            <ui:Label text="Phase 3 : RECONSTRUCTION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px;" />
        </ui:VisualElement>
        <ui:VisualElement name="MoneyIcon" style="flex-grow: 1; top: 20px; left: 50px; background-image: url(&quot;project://database/Assets/Content/Sprites/money.png?fileID=2800000&amp;guid=df443dca3845297479faa41c489791b0&amp;type=3#money&quot;); width: 50%; height: 50%; min-width: 100px; min-height: 75px; max-width: 0%; max-height: 0%; position: absolute; bottom: 0%; right: 0%; align-self: center; align-content: center; align-items: flex-start; flex-direction: column;">
            <ui:Label text="10 000 $" name="MoneyLabel" style="top: 70px; left: -25px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        <ui:Button text="Next Phase" name="NextPhaseButton" style="position: absolute; top: 20px; left: 1200px; height: 75px; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); background-color: rgba(255, 255, 255, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=b54162c1e1e49734a9d0768eafe0912d&amp;type=3#NotInter-Regular&quot;);" />
    </ui:VisualElement>
</ui:UXML>
