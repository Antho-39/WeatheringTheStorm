    <ui:VisualElement name="4Starrating" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Community Champion”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“Fantastic job! Homes restored, morale high, and the city’s &#10;&#10;buzzing with hope. Replay if you’re chasing perfection&#10;&#10;—we believe in you!”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“Boom! You crushed it like a water drop on a flame. &#10;&#10;The community’s cheering your name. &#10;&#10;One more run and you’ll be a wildfire legend!”" name="CommunityChampion" parse-escape-sequences="false" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 25px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px;" />
