<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Container" style="flex-grow: 1;">
        <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
            <ui:Label text="Phase 3 : RECONSTRUCTION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px;" />
        </ui:VisualElement>
        <ui:VisualElement name="MoneyIcon" style="flex-grow: 1; top: 20px; left: 50px; background-image: url(&quot;project://database/Assets/Content/Sprites/money.png?fileID=2800000&amp;guid=df443dca3845297479faa41c489791b0&amp;type=3#money&quot;); width: 50%; height: 50%; min-width: 100px; min-height: 75px; max-width: 0%; max-height: 0%; position: absolute; bottom: 0%; right: 0%; align-self: center; align-content: center; align-items: flex-start; flex-direction: column;">
            <ui:Label text="10 000 $" name="MoneyLabel" style="top: 70px; left: -25px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        <ui:VisualElement name="ScoreIcon" style="flex-grow: 1; top: 177px; left: 51px; background-image: url(&quot;project://database/Assets/Content/Sprites/score.png?fileID=2800000&amp;guid=b790b66db0b6f0e47a1157575e3a70c6&amp;type=3#score&quot;); width: 50%; height: 50%; min-width: 100px; min-height: 75px; max-width: 0%; max-height: 0%; position: absolute; bottom: 0%; right: 0%; align-self: center; align-content: center; align-items: flex-start; flex-direction: column;">
            <ui:Label text="Score:" name="ScoreText" style="top: 70px; left: -25px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
            <ui:Label text="0" name="ScoreLabel" style="top: 17px; left: 129px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center; align-items: flex-start;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
