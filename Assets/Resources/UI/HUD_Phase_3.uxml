<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;b&gt;Welcome back !&lt;/b&gt;&#10;&#10;&#10;Montparis Bay owes you.&#10;&#10;&#10;Now comes the hardest part, rebuilding:&#10;&#10;&#10;&lt;color=yellow&gt;- Repair homes&lt;/color=yellow&gt; so families can return.&#10;&#10;&lt;color=yellow&gt;- Restore our environment&lt;/color=yellow&gt; plant new trees.&#10;&#10;&lt;color=yellow&gt;- Lift community morale&lt;/color=yellow&gt; because hope is as vital as water.&lt;/color=yellow&gt;&#10;&#10;&#10;Volunteers, supplies, and even a disaster relief fund of &lt;b&gt;&lt;color=purple&gt;$4,990 to $5,010&lt;/color=purple&gt;&lt;/b&gt; &#10;&#10;&#10;are rolling in.&#10;&#10;&#10;&#10;Ready to turn ashes into opportunity?&quot;" name="IntroText" selectable="true" focusable="true" parse-escape-sequences="true" emoji-fallback-support="false" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 20px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 410px; width: 422px; top: 670px; left: 0; background-image: url(&quot;project://database/Assets/Content/Images/Mayor.png?fileID=2800000&amp;guid=0d0639b5dc48008448f48cfb8977c7b2&amp;type=3#Mayor&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
