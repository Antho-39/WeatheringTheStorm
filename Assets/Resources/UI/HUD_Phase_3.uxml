    <ui:VisualElement name="3Starrating" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Holding the Line”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10; “Solid work! Montparis Bay survived, but scars remain.&#10;&#10;People are grateful, yet dreaming of a stronger comeback. &#10;&#10;Want to aim higher?”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“Nice! You fought hard, saved lives, and gave the fire &#10;&#10;a run for its money. Social impact? Decent. &#10;&#10;But hey, why settle for decent?”" name="Holdingtheline" parse-escape-sequences="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 25px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px;" />
