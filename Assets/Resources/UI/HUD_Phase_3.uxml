<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;b&gt;Welcome back !&lt;/b&gt;&#10;&#10;Montparis Bay owes you. The fire took its toll—homes lost, habitats scarred—but because of your courage, we still have a future to fight for.&#10;Now comes the hardest part: rebuilding.&#10;&lt;b&gt;Let&apos;s work on it !&lt;/b&gt;&#10;&#10;&lt;color=yellow&gt;- Repair homes so families can return.&#10;- Restore our environment—plant new life, heal the land.&#10;- Lift community morale—because hope is as vital as water.&lt;/color=yellow&gt;&#10;&#10;The good news ? Help is on the way. Volunteers, supplies, and even a disaster relief fund of &lt;b&gt;&lt;color=purple&gt;$15,000 to $20,000&lt;/color=purple&gt;&lt;/b&gt; are rolling in. We’re not alone in this. Together, we’ll make Montparis Bay safer.&#10;&#10;You’ve already proven you can lead in a crisis. Now, let’s lead in recovery. Ready to turn ashes into opportunity?&quot;" name="IntroText" selectable="true" focusable="true" parse-escape-sequences="true" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 30px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 200px; width: 200px; top: 75%; left: 2%; background-image: url(&quot;project://database/Assets/Content/Sprites/sunglasses.png?fileID=2800000&amp;guid=d11d83dbad23aba43bb75ca1e99b122b&amp;type=3#sunglasses&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Button text="NEXT" name="IntroNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="Controls" style="flex-grow: 1; display: none;">
