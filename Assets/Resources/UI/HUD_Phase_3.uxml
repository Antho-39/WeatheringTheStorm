    </ui:VisualElement>
    <ui:VisualElement name="Phase_3" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
            <ui:Label text="Phase 3 : RECONSTRUCTION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
