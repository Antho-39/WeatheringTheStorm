    <ui:VisualElement name="1Starrating" style="flex-grow: 1; display: none;">
        <ui:Label text="&lt;color=yellow&gt;“Ashes and Regrets”&lt;/color=yellow&gt;&#10;&#10;&#10;&lt;color=purple&gt;&lt;b&gt;Mayor:&lt;/color=purple&gt;&lt;/b&gt;  &#10;“Montparis Bay looks… crispy. &#10;&#10;We’ll rebuild, but next time, maybe don’t roast the whole town? &#10;&#10;Our community morale is in the basement—give it another shot!”&#10;&#10;&#10;&lt;color=green&gt;&lt;b&gt;Captain:&lt;/color=green&gt;&lt;/b&gt;&#10;  “Yikes! That fire danced circles around us. &#10;&#10;Social impact? Let’s just say the squirrels are filing complaints. &#10;&#10;Hop back in and show those flames who’s boss!”" name="Ashesandregrest" selectable="true" focusable="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 25px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px;" />
