        <ui:VisualElement name="FiveStarrating" style="flex-grow: 1; display: none; left: 25px; width: 1850px;">
            <ui:Label text="&lt;b&gt;&lt;color=yellow&gt;“Hero of Montparis Bay”&lt;/color&gt;&#10;&#10;&#10;&lt;b&gt;&lt;color=purple&gt;Mayor:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“You did it! Our city stands stronger than ever, and morale is through &#10;&#10;the roof. You’ve set the gold standard for wildfire resilience!”&#10;&#10;&#10;&lt;b&gt;&lt;color=green&gt;Captain:&lt;/b&gt;&lt;/color&gt;&#10;&#10;“Five stars! You’re the fire-fighting rockstar Montparis Bay needed. &#10;&#10;Social impact? Off the charts. &#10;&#10;Replay just for bragging rights!”" name="HeroofMontparisBay" parse-escape-sequences="true" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 24px; color: rgb(255, 255, 255); background-color: rgb(0, 0, 0); top: 190px; border-top-width: 10px; border-left-width: 10px;" />
