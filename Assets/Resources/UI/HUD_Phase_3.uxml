        <ui:VisualElement name="ResultPanel" style="flex-grow: 1; position: absolute; top: 10%; left: 5%; width: 80%; height: 80%;">
            <ui:VisualElement name="EndPhase2" style="flex-grow: 1; width: 425px; height: 380px; top: 100px; left: -1px; align-content: stretch; align-self: flex-start; right: 1186px; bottom: 612px; align-items: stretch; justify-content: flex-start; position: absolute; text-shadow: 0 0 0 rgb(0, 0, 0); background-color: rgba(0, 0, 0, 0.98); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 15px;">
                <ui:Label text="End of Phase 2 results:" name="ResulatLabel" style="color: rgb(255, 255, 255); font-size: 15px; -unity-font-style: bold; width: 425px; height: 50px; margin-left: 10px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
                <ui:Label text="- 4 burnt homes" name="HomeLabel" style="color: rgb(255, 236, 0); font-size: 15px; -unity-font-style: bold; width: 425px; height: 50px; margin-left: 10px; top: 50px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
                <ui:Label text="- 10 trees burnt down" name="TreeLabel" style="color: rgb(255, 236, 0); font-size: 15px; -unity-font-style: bold; width: 425px; height: 50px; margin-left: 10px; top: 50px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
                <ui:Label text="You can&apos;t exceed these &#10;numbers for reparation." name="LabelWarning" style="top: 60px; -unity-font-style: italic; color: rgb(255, 255, 255); font-size: 10px; margin-left: 8px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
