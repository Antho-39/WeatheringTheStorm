<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: none;">
        <ui:Label text="&quot;Hey rookie! Captain Blaze Montreaux reporting from the skies.&#10;&#10;&#10;The wildfire’s on the move, and we’ve got no time to waste. Here’s &#10;&#10;the deal:&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Suppress the fire&lt;/b&gt;&lt;/color&gt; — target those hotspots before they turn into &#10;&#10;infernos.&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Rescue people &amp; animals&lt;/b&gt;&lt;/color&gt; - fly over them and stay put for a sec so &#10;&#10;they can get in, then bring them to a safe zone&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Refill your chopper with water&lt;/b&gt;&lt;/color&gt; — fly over water &amp; refill.&#10;&#10;&#10;&#x9;&#x9;&#10;&#x9;&#x9;Every second counts, and the fire doesn’t play fair.&#10;&#10;&#x9;&#x9;&#10;&#x9;&#x9;&#10;&#x9;&#x9;Get ready for &lt;color=purple&gt;&lt;b&gt;4 min&lt;/b&gt;&lt;/color&gt; of flames.&#10;&#10;" name="IntroText" selectable="false" focusable="false" parse-escape-sequences="false" double-click-selects-word="false" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 25px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 568px; width: 556px; top: 538px; left: -18px; background-image: url(&quot;project://database/Assets/Content/Images/Captain.png?fileID=2800000&amp;guid=5a9cfbaca0872d542ab5da85a91bb713&amp;type=3#Captain&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Button text="NEXT" name="IntroNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); display: flex;" />
    </ui:VisualElement>
    <ui:VisualElement name="Controls" style="flex-grow: 1; display: none; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;);">
        <ui:Label text="&#x9;&#x9;&#x9;&lt;size=80&gt;&lt;color=yellow&gt;&lt;b&gt;Controls&lt;/color=yellow&gt;&lt;/b&gt;&lt;/size&gt;" name="ControlsText" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 45px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement name="MouseWheel" style="flex-grow: 1; position: absolute; top: 25%; left: 15%; width: 150px; height: 150px; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_arrows_all.png?fileID=2800000&amp;guid=cf708262169702e4fb764deb8c2f9d05&amp;type=3#keyboard_arrows_all&quot;);" />
        <ui:VisualElement name="MouseMove" style="flex-grow: 1; position: absolute; top: 40%; left: 15%; width: 150px; height: 150px; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_space_outline.png?fileID=2800000&amp;guid=28efeb42491f001409479b7ff252b1c7&amp;type=3#keyboard_space_outline&quot;);" />
        <ui:Label text="Move around the map &#10;with the 4 arrows" name="MoveControlArrows" style="position: absolute; top: 315px; left: 820px; width: 774px; height: 79px; color: rgb(255, 255, 255); font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Button text="NEXT" name="ControlsNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Label text="Use space bar to spray water&#10;Refill automaticaly when&#10;flying above water&#10;" name="MoveControlSpacebar" style="position: absolute; top: 450px; left: 820px; width: 774px; height: 5%; color: rgb(255, 255, 255); font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Label text="You can also use a game pad&#10;" name="Gamepad" style="position: absolute; top: 734px; left: 175px; width: 774px; height: 5%; color: rgb(255, 255, 255); font-size: 35px; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/Content/Images/GamePadControls.png?fileID=2800000&amp;guid=ea8ef6b783108e840b703d5fd055493c&amp;type=3#GamePadControls&quot;); height: 222px; width: 343px; top: 661px; left: 1281px;" />
    </ui:VisualElement>
    <ui:VisualElement name="Phase_2" style="flex-grow: 1; display: flex;">
        <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
            <ui:Label text="Phase 2 : ACTION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="TimeIcon" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Images/Timer.png?fileID=2800000&amp;guid=05b8c06411403c64bb7d1d5697e509b0&amp;type=3#Timer&quot;); background-size: 150% 150%; width: 75px; height: 75px; top: 10px; left: 50px; position: absolute;">
            <ui:Label text="3:00" name="TimeLabel" style="position: absolute; top: 65px; left: 10px; height: 50px; width: 50px; justify-content: flex-start; align-self: center; align-content: center; -unity-text-align: middle-center; font-size: 25px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); background-color: rgba(255, 255, 255, 0); -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:Label text="WATER" name="GaugeLabel" style="font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; left: 1%; bottom: 51px; top: 95%; -unity-text-outline-width: 0.5px; width: 92px; height: 34px; position: absolute;">
            <ui:VisualElement name="GaugeRoot" class="gauge-root" style="bottom: 0%; top: -2%; left: 9%;">
                <ui:VisualElement name="GaugeBackground" class="gauge-background" style="left: 82px;">
                    <ui:VisualElement name="GaugeFill" class="gauge-fill" />
                </ui:VisualElement>
                <ui:Label name="ValueLabel" class="gauge-label" />
            </ui:VisualElement>
            <ui:VisualElement name="GaugeCross" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Sprites/block.png?fileID=2800000&amp;guid=cb936bb6c2ecce64891e444608ba3ffa&amp;type=3#block&quot;); position: absolute; height: 75px; width: 75px; top: -23px; left: 1px; display: none;" />
        </ui:Label>
        <ui:VisualElement name="Root" style="flex-direction: column; align-items: center; justify-content: flex-end; width: 100%; height: 100%;">
            <ui:VisualElement name="RescueDirectionArrow" class="direction-arrow" style="display: flex; background-image: url(&quot;project://database/Assets/Content/Sprites/right-arrow.png?fileID=2800000&amp;guid=a722efb52930fd84dbd0687896933010&amp;type=3#right-arrow&quot;); width: 75px; height: 75px; flex-direction: column; rotate: 0;" />
            <ui:Label name="RescueAlertLabel" text="Rescue Alert!" class="rescue-label" style="display: flex; width: 800px; height: 200px; white-space: normal; background-color: rgba(0, 0, 0, 0.99); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-top-left-radius: 15px; border-bottom-left-radius: 15px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 40px;" />
            <ui:Slider name="RescueTimerSlider" low-value="0" high-value="20" show-input="false" class="rescue-timer" style="display: flex; height: 75px; width: 500px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
