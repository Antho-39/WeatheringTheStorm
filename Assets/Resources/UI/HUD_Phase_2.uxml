<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_Phase_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_Phase_StyleSheet" />
    <ui:VisualElement name="Intro" style="flex-grow: 1; display: none;">
        <ui:Label text="&quot;Hey rookie! Captain Blaze Montreaux reporting from the skies.&#10;&#10;&#10;The wildfire’s on the move, and we’ve got no time to waste. Here’s &#10;&#10;the deal:&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Suppress the fire&lt;/b&gt;&lt;/color&gt; — target those hotspots before they turn into &#10;&#10;infernos.&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Rescue people &amp; animals&lt;/b&gt;&lt;/color&gt; - fly over them and stay put for a sec so &#10;&#10;they can get in, then bring them to a safe zone.&#10;&#10;&#10;&lt;color=yellow&gt;&lt;b&gt;Refill your chopper with water&lt;/b&gt;&lt;/color&gt; — fly over water &amp; refill.&#10;&#10;&#10;&#x9;&#x9;&#10;&#x9;&#x9;&#10;&#10;&#x9;&#x9;&#10;&#x9;&#x9;&#10;&#x9;&#x9;Get ready for &lt;color=purple&gt;&lt;b&gt;4 min&lt;/b&gt;&lt;/color&gt; of BLAZESTORM.&#10;&#10;" name="IntroText" selectable="false" focusable="false" parse-escape-sequences="false" double-click-selects-word="false" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 25px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:VisualElement name="CharacterImage" style="flex-grow: 1; position: absolute; height: 568px; width: 556px; top: 538px; left: -18px; background-image: url(&quot;project://database/Assets/Content/Images/Captain.png?fileID=2800000&amp;guid=5a9cfbaca0872d542ab5da85a91bb713&amp;type=3#Captain&quot;);" />
        <ui:Button text="Skip" name="SkipButton" style="position: absolute; top: 88%; left: 25%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Button text="NEXT" name="IntroNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); display: flex;" />
    </ui:VisualElement>
    <ui:VisualElement name="Controls" style="flex-grow: 1; display: none; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PixelifySans-VariableFont_wght.ttf?fileID=12800000&amp;guid=01aebf42bf5c54e488dbe542a6e17f57&amp;type=3#PixelifySans-VariableFont_wght&quot;);">
        <ui:Label text="&#x9;&#x9;&#x9;&lt;size=80&gt;&lt;color=yellow&gt;&lt;b&gt;Controls&lt;/color=yellow&gt;&lt;/b&gt;&lt;/size&gt;" name="ControlsText" style="justify-content: center; align-self: stretch; align-content: stretch; width: 90%; height: 85%; -unity-text-align: upper-left; top: 2%; left: 5%; color: rgb(255, 255, 255); font-size: 45px; background-color: rgba(0, 0, 0, 0.99); padding-top: 35px; padding-right: 25px; padding-bottom: 15px; padding-left: 25px; white-space: normal; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);">
            <ui:Label text="Forward" name="GamePadforward" style="position: absolute; top: 620px; left: 1244px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); color: rgb(255, 255, 255); font-size: 20px;" />
            <ui:Label text="Water Cannon" name="AWatercannon" style="position: absolute; top: 800px; left: 1326px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); color: rgb(255, 255, 255); font-size: 20px;" />
        </ui:Label>
        <ui:VisualElement name="MouseMove" style="flex-grow: 1; position: absolute; top: 448px; left: 256px; width: 150px; height: 150px; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_space_outline.png?fileID=2800000&amp;guid=28efeb42491f001409479b7ff252b1c7&amp;type=3#keyboard_space_outline&quot;);" />
        <ui:Label text="Move with the 4 arrows" name="MoveControlArrows" style="position: absolute; top: 321px; left: 488px; width: 1164px; height: 79px; color: rgb(255, 255, 255); font-size: 30px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);">
            <ui:VisualElement name="Downarrow" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_arrow_down.png?fileID=2800000&amp;guid=f3eb6f565f0143042b43e3d8dc51c82d&amp;type=3#keyboard_arrow_down&quot;); position: absolute; height: 90px; width: 90px; top: 20px; left: -215px;" />
            <ui:VisualElement name="Uparrow" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_arrow_up.png?fileID=2800000&amp;guid=23bc0e65dcd00af41af830378f9301e5&amp;type=3#keyboard_arrow_up&quot;); position: absolute; height: 90px; width: 90px; top: -64px; left: -217px;" />
            <ui:VisualElement name="Leftwnarrow" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_arrow_left.png?fileID=2800000&amp;guid=35c1ad64658969f44ab5eec3e98e43fb&amp;type=3#keyboard_arrow_left&quot;); position: absolute; height: 90px; width: 90px; top: 22px; left: -303px;" />
            <ui:VisualElement name="Rightarrow" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/UI/MouseAndKey/keyboard_arrow_right.png?fileID=2800000&amp;guid=6a1026cc38cbf244889f84aad6a6675a&amp;type=3#keyboard_arrow_right&quot;); position: absolute; height: 90px; width: 90px; top: 20px; left: -129px;" />
        </ui:Label>
        <ui:Button text="NEXT" name="ControlsNextButton" style="position: absolute; top: 88%; left: 60%; width: 200px; background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); height: 100px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); font-size: 25px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;);" />
        <ui:Label text="You can also &#10;use a game pad&#10;" name="Gamepad" style="position: absolute; top: 770px; left: 119px; width: 508px; height: 5%; color: rgb(255, 255, 255); font-size: 35px; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); flex-wrap: wrap;" />
        <ui:VisualElement name="AXboxImage" style="flex-grow: 1; position: absolute; height: 94px; width: 96px; top: 794px; left: 1332px; background-image: url(&quot;project://database/Assets/Content/Sprites/xbox_button_a.png?fileID=2800000&amp;guid=6448d55d25f274b4f953758fb4fe145a&amp;type=3#xbox_button_a&quot;);" />
