<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/HUD_StyleSheet.uss?fileID=7433441132597879392&amp;guid=c5125b75148dc984ebf29720ea8614f8&amp;type=3#HUD_StyleSheet" />
    <ui:VisualElement name="Container" style="flex-grow: 1;">
        <ui:VisualElement name="Header" class="header" style="flex-grow: 1;">
            <ui:Label text="Phase 2 : ACTION" name="HeaderLabel" class="header" style="align-items: center; justify-content: center; align-self: center; font-size: 50px; padding-top: 25px;" />
        </ui:VisualElement>
        <ui:VisualElement name="TimeIcon" style="flex-grow: 1; background-image: resource(&apos;Sprites/circle&apos;); background-size: 150% 150%; width: 150px; height: 150px; top: 5px; left: 5px; position: absolute;">
            <ui:Label text="3:00" name="TimeLabel" style="position: absolute; top: 45px; left: 50px; height: 50px; width: 50px; justify-content: flex-start; align-self: center; align-content: center; -unity-text-align: middle-center; font-size: 35px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="MoneyIcon" style="flex-grow: 1; top: 20px; left: 200px; background-image: resource(&apos;Sprites/money&apos;); width: 50%; height: 50%; min-width: 100px; min-height: 75px; max-width: 0%; max-height: 0%; position: absolute; bottom: 0%; right: 0%; align-self: center; align-content: center; align-items: flex-start; flex-direction: column;">
            <ui:Label text="10 000 $" name="MoneyLabel" style="top: 70px; left: -25px; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-center;" />
        </ui:VisualElement>
        <ui:VisualElement name="ScoreIcon" style="flex-grow: 1; width: 150px; height: 150px; top: 5px; left: 350px; background-image: resource(&apos;Sprites/score&apos;); min-width: 0; min-height: 0; max-width: 150px; max-height: 100px; background-size: 150px 150px; position: absolute;">
            <ui:Label text="50" name="ScoreLabel" style="top: 85px; left: 0; height: 50px; width: 150px; -unity-text-outline-width: 0.5px; -unity-text-align: middle-center; font-size: 35px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:Label text="WATER" name="GaugeLabel" style="font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; left: 1%; bottom: 51px; top: -2%; -unity-text-outline-width: 0.5px; width: 92px; height: 34px;">
            <ui:VisualElement name="GaugeRoot" class="gauge-root" style="bottom: 0%; top: -2%; left: 9%;">
                <ui:VisualElement name="GaugeBackground" class="gauge-background" style="left: 82px;">
                    <ui:VisualElement name="GaugeFill" class="gauge-fill" />
                </ui:VisualElement>
                <ui:Label name="ValueLabel" class="gauge-label" />
            </ui:VisualElement>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
