<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=ec236c602a40a514f8c108c6eaeea82d&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="Container" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/Background/8-bit-graphics-pixels-scene-with-forest.jpg?fileID=2800000&amp;guid=4483aa22985828e47a103b86deb8ab19&amp;type=3#8-bit-graphics-pixels-scene-with-forest&quot;);">
        <ui:Label text="Welcome to WildFire Watch " name="LabelTitle" class="header" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PressStart2P.ttf?fileID=12800000&amp;guid=a665539b40a087442af9db27c08ce354&amp;type=3#PressStart2P&quot;); -unity-text-align: upper-center; -unity-font-style: bold; margin-top: 200px; font-size: 50px; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.59); background-size: 50% 50%; width: auto; align-items: center; justify-content: flex-end; align-self: center;" />
        <ui:Label text="“Outsmart the wildfire: &#10;&#10;prepare, act, and rebuild to save your community before the flames consume everything.”" name="LabelContent" style="font-size: 20px; -unity-font-style: bold; align-self: center; background-color: rgba(0, 0, 0, 0.59); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/dogicapixel.ttf?fileID=12800000&amp;guid=89ced42ac5ee42047ac8548488e25f3b&amp;type=3#dogicapixel&quot;); text-shadow: 0 0 0 rgb(0, 0, 0);" />
        <ui:Button text="Play" name="ButtonPlay" class="button" style="background-size: 100% 100%; margin-top: 400px; -unity-font-style: bold; font-size: 45px; width: 300px; height: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/dogicapixelbold.ttf?fileID=12800000&amp;guid=af4e64ed176a64f418ca396aca22a457&amp;type=3#dogicapixelbold&quot;); background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;); background-color: rgba(255, 255, 255, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
        <ui:Button text="Leave" name="ButtonLeave" class="button" style="margin-top: 50px; font-size: 45px; -unity-font-style: bold; width: 300px; height: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/dogicapixelbold.ttf?fileID=12800000&amp;guid=af4e64ed176a64f418ca396aca22a457&amp;type=3#dogicapixelbold&quot;); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Content/Sprites/button1.png?fileID=2800000&amp;guid=b814c62821ecef546a2cf267da971541&amp;type=3#button1&quot;);" />
