<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=ec236c602a40a514f8c108c6eaeea82d&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="MainMenuUI" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Content/Textures/Background/8-bit-graphics-pixels-scene-with-forest.jpg?fileID=2800000&amp;guid=4483aa22985828e47a103b86deb8ab19&amp;type=3#8-bit-graphics-pixels-scene-with-forest&quot;); display: none;">
        <ui:Label text="Welcome to &#10;&#10;BLAZESTORM" name="Title" class="header" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/PressStart2P.ttf?fileID=12800000&amp;guid=a665539b40a087442af9db27c08ce354&amp;type=3#PressStart2P&quot;); -unity-text-align: upper-center; -unity-font-style: bold; margin-top: 200px; font-size: 50px; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.59); background-size: 50% 50%; width: auto; align-items: center; justify-content: flex-end; align-self: center;" />
        <ui:Label text="“Outsmart the wildfire: &#10;&#10;prepare, act, and rebuild to save your community before the flames consume everything.”" name="Tagline" style="font-size: 25px; -unity-font-style: bold; align-self: center; background-color: rgba(0, 0, 0, 0.59); color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/dogicapixel.ttf?fileID=12800000&amp;guid=89ced42ac5ee42047ac8548488e25f3b&amp;type=3#dogicapixel&quot;); text-shadow: 0 0 0 rgb(0, 0, 0); -unity-text-align: lower-center; overflow: hidden; margin-top: 60px;" />
        <ui:Button text="Play" name="ButtonPlay" class="button" style="background-size: 100% 100%; margin-top: 300px; -unity-font-style: bold; font-size: 40px; width: 300px; height: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); background-color: rgba(255, 255, 255, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); color: rgb(0, 0, 0);" />
        <ui:Button text="Leave" name="ButtonLeave" class="button" style="margin-top: 50px; font-size: 40px; -unity-font-style: bold; width: 300px; height: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); color: rgb(0, 0, 0);" />
        <ui:Button text="How to Score?" name="ButtonHowtoscore" class="button" style="margin-top: 50px; font-size: 20px; -unity-font-style: bold; width: 443px; height: 100px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); color: rgb(0, 0, 0); position: absolute; top: 30px; left: 51px;" />
    </ui:VisualElement>
    <ui:VisualElement name="HowToScoreUI" style="flex-grow: 1; display: flex;">
        <ui:Label text="&#10;&#x9;&lt;color=yellow&gt;&lt;b&gt;How to score?&lt;/b&gt;&lt;/color=yellow&gt;&#10;&#10;&#10;&#10;You will get a &lt;color=yellow&gt;&lt;b&gt;5 star rating&lt;/b&gt;&lt;/color=yellow&gt; at the end of the game based on the points acquired:&#10;&#10;&#10;&#10;Get Points by:&#10;&#10;&#x9;- Buying a FireCrew &lt;color=green&gt;&lt;b&gt;+ 10 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Buying a Fire line/Safe zone &lt;color=green&gt;&lt;b&gt;+ 20 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Supressing a fire super fast &lt;color=green&gt;&lt;b&gt;+ 10 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Successfully completing a rescue mission &lt;color=green&gt;&lt;b&gt;+ 50 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Rebuilding house &lt;color=green&gt;&lt;b&gt;+ 30 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Rebuilding house up to Fire code &lt;color=green&gt;&lt;b&gt;+ 90 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#x9;- Replanting a tree &lt;color=green&gt;&lt;b&gt;+ 4 pts&lt;/b&gt;&lt;/color=green&gt;&#10;&#10;&#10;&#10;&#10;&#10;Lose Points by:&#10;&#10;&#x9;- Having a burnt tree &lt;color=red&gt;&lt;b&gt;- 1 pt&lt;/b&gt;&lt;/color=red&gt;&#10;&#x9;&#10;&#x9;- Having a burnt house &lt;color=red&gt;&lt;b&gt;- 5 pts&lt;/b&gt;&lt;/color=red&gt;&#10;&#10;&#x9;- Supress a fire too slowly &lt;color=red&gt;&lt;b&gt;- 1 pt&lt;/b&gt;&lt;/color=red&gt;&#10;&#10;&#10;&#10;Make the most of your money in Phase 1 &lt;color=purple&gt;&lt;b&gt;($10K)&lt;/b&gt;&lt;/color=purlple&gt; and Phase 3 &lt;color=purple&gt;&lt;b&gt;(Approx. $5K)&lt;/b&gt;&lt;/color=purlple&gt;&#10;&#10;to optimize your points!&#10;&#10;&#10;GOOD LUCK!&#10;" name="Howtoscoreexplanation" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 20px; color: rgb(229, 229, 229); background-color: rgb(0, 0, 0); width: 100%; height: 100%; position: absolute; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        <ui:Button text="Back" name="Buttonhowtoscoreback" selectable="true" style="background-image: url(&quot;project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&amp;guid=3437c6ef9a275c9438e32327c27d8fd4&amp;type=3#Button mid&quot;); position: absolute; height: 54px; width: 138px; top: 945px; left: 1483px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/prstartk.ttf?fileID=12800000&amp;guid=4ef2032f4a7925943809588411c48562&amp;type=3#prstartk&quot;); font-size: 20px; -unity-font-style: bold; background-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
