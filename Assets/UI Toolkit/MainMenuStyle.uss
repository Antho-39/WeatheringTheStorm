    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-image: url("project://database/Assets/Content/Sprites/button1.png?fileID=2800000&guid=b814c62821ecef546a2cf267da971541&type=3#button1");
    margin-top: 100px;
}
