:root {
}

.header {
    font-size: 40px;
    color: rgb(255, 255, 255);
}

.button {
    font-size: 20px;
    width: 220px;
    height: 60px;
    align-self: center;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-image: url("project://database/Assets/Content/Images/Button%20mid.png?fileID=2800000&guid=3437c6ef9a275c9438e32327c27d8fd4&type=3#Button mid");
    margin-top: 100px;
}
